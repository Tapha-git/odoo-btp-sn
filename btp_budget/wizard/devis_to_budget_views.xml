<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_btp_devis_to_budget_wizard_form" model="ir.ui.view">
        <field name="name">btp.devis.to.budget.wizard.form</field>
        <field name="model">btp.devis.to.budget.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer budget">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="devis_id"/>
                    <field name="chantier_id"/>
                    <field name="budget_type"/>
                    <field name="auto_validate"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_btp_devis_to_budget_wizard" model="ir.actions.act_window">
        <field name="name">Générer budget</field>
        <field name="res_model">btp.devis.to.budget.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
