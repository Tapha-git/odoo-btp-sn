<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_btp_ouvrage_tree" model="ir.ui.view">
        <field name="name">btp.ouvrage.tree</field>
        <field name="model">btp.ouvrage</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="uom_id"/>
                <field name="validated_version_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_btp_ouvrage_form" model="ir.ui.view">
        <field name="name">btp.ouvrage.form</field>
        <field name="model">btp.ouvrage</field>
        <field name="arch" type="xml">
            <form string="Ouvrage">
                <header>
                    <button name="action_create_version" type="object" string="Nouvelle version" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="uom_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Versions">
                            <field name="version_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="cost_direct"/>
                                    <field name="sale_unit_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_btp_ouvrage_version_tree" model="ir.ui.view">
        <field name="name">btp.ouvrage.version.tree</field>
        <field name="model">btp.ouvrage.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="ouvrage_id"/>
                <field name="date"/>
                <field name="name"/>
                <field name="state"/>
                <field name="cost_direct"/>
                <field name="cost_total"/>
                <field name="sale_unit_price"/>
            </list>
        </field>
    </record>

    <record id="view_btp_ouvrage_version_form" model="ir.ui.view">
        <field name="name">btp.ouvrage.version.form</field>
        <field name="model">btp.ouvrage.version</field>
        <field name="arch" type="xml">
            <form string="Version d'ouvrage">
                <header>
                    <button name="action_validate" type="object" string="Valider" class="btn-primary"
                            invisible="state != 'draft'" groups="btp_senegal.group_btp_directeur_tech,btp_senegal.group_btp_admin"/>
                    <button name="action_archive" type="object" string="Archiver"
                            invisible="state == 'archived'" groups="btp_senegal.group_btp_metreur,btp_senegal.group_btp_admin"/>
                    <button name="action_reset_to_draft" type="object" string="Remettre en brouillon"
                            invisible="state != 'archived'" groups="btp_senegal.group_btp_admin"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,archived"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ouvrage_id"/>
                            <field name="date"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="overhead_site_pct"/>
                            <field name="overhead_general_pct"/>
                            <field name="risk_pct"/>
                            <field name="margin_pct"/>
                        </group>
                    </group>
                    <group string="Résultats (PU)">
                        <field name="cost_direct" readonly="1"/>
                        <field name="cost_total" readonly="1"/>
                        <field name="sale_unit_price" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Sous-détail de prix">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="resource_nature_id"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_btp_ouvrage" model="ir.actions.act_window">
        <field name="name">Bibliothèque d'ouvrages</field>
        <field name="res_model">btp.ouvrage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_btp_ouvrage_version" model="ir.actions.act_window">
        <field name="name">Versions d'ouvrages</field>
        <field name="res_model">btp.ouvrage.version</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
