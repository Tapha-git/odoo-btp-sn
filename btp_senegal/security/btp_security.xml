<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_btp" model="ir.module.category">
        <field name="name">BTP</field>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_btp" model="res.groups.privilege">
        <field name="name">BTP</field>
        <field name="category_id" ref="btp_senegal.module_category_btp"/>
        <field name="sequence">60</field>
    </record>

    <record id="group_btp_admin" model="res.groups">
        <field name="name">Administrateur BTP</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_directeur_tech" model="res.groups">
        <field name="name">Directeur technique</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_conducteur_travaux" model="res.groups">
        <field name="name">Conducteur de travaux</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_chef_chantier" model="res.groups">
        <field name="name">Chef de chantier</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_metreur" model="res.groups">
        <field name="name">Métreur / Études de prix</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_acheteur" model="res.groups">
        <field name="name">Acheteur</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_magasinier" model="res.groups">
        <field name="name">Magasinier</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_rh" model="res.groups">
        <field name="name">RH chantier</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_comptable" model="res.groups">
        <field name="name">Comptable</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_direction" model="res.groups">
        <field name="name">Direction générale</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>
    <record id="group_btp_lecteur" model="res.groups">
        <field name="name">Lecteur / Reporting</field>
        <field name="privilege_id" ref="btp_senegal.privilege_btp"/>
    </record>

    <!-- Record rules -->
    <record id="rule_btp_chantier_admin_all" model="ir.rule">
        <field name="name">Chantiers - accès complet (admin/direction)</field>
        <field name="model_id" ref="model_btp_chantier"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('btp_senegal.group_btp_admin')),
                                   (4, ref('btp_senegal.group_btp_directeur_tech')),
                                   (4, ref('btp_senegal.group_btp_comptable')),
                                   (4, ref('btp_senegal.group_btp_direction')),
                                   (4, ref('btp_senegal.group_btp_lecteur'))]"/>
    </record>

    <record id="rule_btp_chantier_assigned_only" model="ir.rule">
        <field name="name">Chantiers - seulement affectés (CT / Chef)</field>
        <field name="model_id" ref="model_btp_chantier"/>
        <field name="domain_force">['|', ('conducteur_travaux_id', '=', user.id), ('chef_chantier_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('btp_senegal.group_btp_conducteur_travaux')),
                                   (4, ref('btp_senegal.group_btp_chef_chantier'))]"/>
    </record>
</odoo>
